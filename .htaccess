# mod_rewrite nie działa na tym hostingu (potwierdzone: żadna z reguł
# RewriteRule poniżej faktycznie się nie wykonywała), więc cały serwis
# odwołuje się teraz bezpośrednio do plików (*.html, *.php) i parametrów
# w query stringu - żadne przepisywanie adresów już nie jest potrzebne.
#
# To, co zostało, to próba zablokowania bezpośredniego dostępu do plików
# pomocniczych przez mod_authz_core (nie mod_rewrite) - jeśli hosting w
# ogóle ignoruje .htaccess, to i tak nic nie zrobi (ale i nic nie zepsuje).
# config.php/inc/*.php nie mają żadnego kodu wypisującego coś na wyjściu
# (same funkcje/return), więc nawet bez tej blokady bezpośrednie wejście
# pokaże pustą stronę, nie żadne dane.
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
    Require all denied
</FilesMatch>
